# Copiar a .env y completar. En Vercel se cargan en Settings > Environment Variables.
SECRET_KEY=
MONGODB_CONNECTION_STRING=
MONGODB_DATABASE_NAME=Reservas
MONGODB_CONNECTION_TIMEOUT=5000
GEMINI_API_KEY=
CLOUDINARY_CLOUD_NAME=
